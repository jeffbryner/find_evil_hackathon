# Use the existing sift image as the base
FROM sift:latest

# Set working directory for installation
WORKDIR /opt

# Clone the stable version of Volatility 3 and install it with all features
# Using --break-system-packages as requested for newer pip versions in Debian-based distros
RUN git clone -b stable https://github.com/volatilityfoundation/volatility3.git && \
    cd volatility3 && \
    pip install -e ".[full]" --break-system-packages

# Set the working directory to /scratch for forensic work
WORKDIR /scratch

# Entrypoint is inherited from sift:latest, but we can add an alias or path if needed
ENV PATH="/opt/volatility3:${PATH}"
